# Alpaca API (used for market data + optional paper trading)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Webull credentials (for live trading on your Canadian account)
WEBULL_EMAIL=your_webull_email@example.com
WEBULL_PASSWORD=your_webull_password
WEBULL_TRADING_PIN=your_6digit_trading_pin
WEBULL_DEVICE_ID=

# Bot settings
BROKER=webull
# Set BROKER=alpaca to use Alpaca paper trading instead of Webull

ACCOUNT_SIZE=10000
MAX_POSITIONS=3
RISK_PCT_PER_TRADE=0.02
DAILY_HALT_PCT=0.06
SCORE_THRESHOLD=3

DASHBOARD_PORT=8050
